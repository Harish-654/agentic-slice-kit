  "cards": [
    {
      "dot": "cyan",
      "title": "Code decides, the model writes",
      "items": [
        "Steps, mastery, coach hints and concept maps are pure functions, not prompts.",
        "The model only writes lessons and grades typed answers.",
        "Every session ends with a recorded reason."
      ]
    },
    {
      "dot": "emerald",
      "title": "State that persists",
      "items": [
        "run.db keeps append-only history, one learner row per student, and accounts.",
        "Each student's own documents live in uploads/.",
        "Mastery fades, so old topics come back for review."
      ]
    },
    {
      "dot": "amber",
      "title": "Trust boundaries",
      "items": [
        "The answer key and rubric never reach the browser.",
        "Student code runs only in a throwaway Docker container with no network.",
        "Documents are searched only for the student who uploaded them."
      ]
    }
  ]
