{
  "name": "Agentic Slice Kit",
  "build": { "dockerfile": "Dockerfile", "context": ".." },

  // 2 cores keeps a student inside the free 120 core-hour monthly quota. The
  // event runs 9-6 on two days plus optional remote work, so realistic usage
  // is well under the 60 hours a 2-core machine buys. Raising this to 4 cores
  // halves that headroom - do it deliberately, not by reflex.
  "hostRequirements": { "cpus": 2 },

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "expert callback form", "onAutoForward": "notify" }
  },

  "containerEnv": { "FASTEMBED_CACHE_PATH": "/opt/fastembed" },

  // The code sandbox runs every student program in a throwaway Docker container, so the Codespace needs Docker
  // inside it (a Codespace cannot reach a host Docker socket). The images are kept on a volume that survives stops.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": { "moby": false }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "GitHub.copilot",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "editor.formatOnSave": true
      }
    }
  },

  "postCreateCommand": "cp -n .env.example .env || true",
  // Pull the runtime images in the background on every start (a few minutes the first time, about 1.5 GB). Images
  // already there are skipped, so a pull that failed, say on a Docker Hub rate limit, is retried next start.
  "postStartCommand": "nohup python scripts/pull_runtimes.py --wait > /tmp/pull_runtimes.log 2>&1 &",
  "postAttachCommand": "python scripts/doctor.py || true"
}
